<odoo>
    <record id="partner_form_tier" model="ir.ui.view">
        <field name="name">partner.form.tier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_stage.view_partner_form" />
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <field name="state" invisible="1" />
                <field name="validation_status" invisible="1" />
            </field>
        </field>
    </record>

    <record id="partner_form_tier_filter" model="ir.ui.view">
        <field name="name">partner.form.tier.filter</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter
                    name="needs_review"
                    string="Needs my Approval"
                    domain="[('reviewer_ids', 'in', uid), ('state', '=', 'draft')]"
                    help="Partner(s) to Approve"
                />
                <filter
                    name="tier_validated"
                    string="Validated"
                    domain="[('validation_status', '=', 'validated')]"
                    help="Partners validated and ready to be confirmed"
                />
            </filter>
        </field>
    </record>

    <record id="partner_tree_tier_validation" model="ir.ui.view">
        <field name="name">partner.tree.tier.validation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field
                    name="validation_status"
                    widget="badge"
                    optional="hide"
                    decoration-info="validation_status == 'pending'"
                    decoration-danger="validation_status == 'rejected'"
                    decoration-success="validation_status == 'validated'"
                />
            </field>
        </field>
    </record>
</odoo>
